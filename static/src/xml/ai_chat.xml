<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Botón en la barra de Systray -->
    <t t-name="odoo_ai_assistant.SystrayIcon">
        <a href="#" class="ai_assistant_systray_btn" title="Asistente de IA" role="button" t-on-click.prevent="onClick">
            <i class="bi bi-chat-square-quote"/>
        </a>
    </t>

    <!-- Ventana principal del chat flotante -->
    <t t-name="odoo_ai_assistant.ChatWindow">
        <div class="ai_assistant_fab ai_assistant_toggle" title="Asistente de IA">
            <i class="oi oi-apps"/>
            <span class="ai_assistant_fab_pulse"/>
        </div>

        <div class="ai_assistant_window">
            <div class="ai_assistant_header">
                <div class="ai_assistant_header_left">
                    <div class="ai_assistant_header_icon">
                        <i class="oi oi-apps"/>
                    </div>
                    <div class="ai_assistant_header_info">
                        <div class="ai_assistant_header_title">Asistente de IA</div>
                        <div class="ai_assistant_header_status">En línea</div>
                    </div>
                </div>
                <div class="ai_assistant_header_actions">
                    <button class="ai_assistant_header_btn ai_assistant_history_toggle" title="Historial">
                        <i class="bi-history"/>
                    </button>
                    <button class="ai_assistant_header_btn ai_assistant_new_chat" title="Nueva conversación">
                        <i class="bi-plus-lg"/>
                    </button>
                    <button class="ai_assistant_header_btn ai_assistant_close" title="Cerrar">
                        <i class="bi-x-lg"/>
                    </button>
                </div>
            </div>

            <div class="ai_assistant_context_bar" t-if="widget.currentContext &amp;&amp; widget.currentContext.model">
                <span class="ai_assistant_context_badge">
                    <i class="bi-geo-alt"/>
                    <t t-esc="widget.currentContext.module || widget.currentContext.model"/>
                    <t t-if="widget.currentContext.record_id">
                        · #<t t-esc="widget.currentContext.record_id"/>
                    </t>
                </span>
            </div>

            <div class="ai_assistant_history_panel">
                <div class="ai_assistant_history_header">
                    <h4>Conversaciones</h4>
                    <button class="ai_assistant_history_toggle">
                        <i class="fa bi-arrow-left"/>
                    </button>
                </div>
                <div class="ai_assistant_history_list"/>
            </div>

            <div class="ai_assistant_chat_panel">
                <div class="ai_assistant_messages"/>
            </div>

            <div class="ai_assistant_input_area">
                <div class="ai_assistant_input_container">
                    <textarea
                        class="ai_assistant_input"
                        placeholder="Escribe tu mensaje..."
                        rows="1"
                    />
                    <div class="ai_assistant_input_actions">
                        <button class="ai_assistant_send" title="Enviar">
                            <i class="bi-send"/>
                        </button>
                    </div>
                </div>
                <div class="ai_assistant_input_footer">
                    <span class="ai_assistant_powered_by">Potenciado por OpenRouter</span>
                    <button class="ai_assistant_settings" title="Configuración">
                        <i class="bi-gear"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

</odoo>
