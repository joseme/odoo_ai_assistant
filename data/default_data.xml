<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Parámetros de configuración por defecto -->
    <record id="default_gemini_api_key" model="ir.config_parameter">
        <field name="key">ai_assistant.gemini_api_key</field>
        <field name="value"></field>
    </record>

    <record id="default_model_name" model="ir.config_parameter">
        <field name="key">ai_assistant.model_name</field>
        <field name="value">gemini-2.0-flash</field>
    </record>

    <record id="default_tts_voice" model="ir.config_parameter">
        <field name="key">ai_assistant.tts_voice</field>
        <field name="value">es-MX-JorgeNeural</field>
    </record>

    <record id="default_tts_language" model="ir.config_parameter">
        <field name="key">ai_assistant.tts_language</field>
        <field name="value">es</field>
    </record>

    <record id="default_voice_enabled" model="ir.config_parameter">
        <field name="key">ai_assistant.voice_enabled</field>
        <field name="value">True</field>
    </record>

    <record id="default_tts_enabled" model="ir.config_parameter">
        <field name="key">ai_assistant.tts_enabled</field>
        <field name="value">True</field>
    </record>

    <record id="default_web_search_enabled" model="ir.config_parameter">
        <field name="key">ai_assistant.web_search_enabled</field>
        <field name="value">True</field>
    </record>

    <record id="default_knowledge_search_enabled" model="ir.config_parameter">
        <field name="key">ai_assistant.knowledge_search_enabled</field>
        <field name="value">True</field>
    </record>

    <record id="default_welcome_message" model="ir.config_parameter">
        <field name="key">ai_assistant.welcome_message</field>
        <field name="value">¡Hola! Soy tu asistente de IA en Odoo. ¿En qué puedo ayudarte?</field>
    </record>

    <record id="default_max_history" model="ir.config_parameter">
        <field name="key">ai_assistant.max_history</field>
        <field name="value">20</field>
    </record>

    <record id="default_vosk_model" model="ir.config_parameter">
        <field name="key">ai_assistant.vosk_model</field>
        <field name="value">vosk-model-small-es-0.42</field>
    </record>

    <record id="default_vosk_model_path" model="ir.config_parameter">
        <field name="key">ai_assistant.vosk_model_path</field>
        <field name="value">/opt/vosk-models</field>
    </record>

</odoo>
