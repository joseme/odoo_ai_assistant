<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Grupo de acceso para el Asistente de IA -->
    <record id="group_ai_assistant_user" model="res.groups">
        <field name="name">AI Assistant / User</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_assistant_manager" model="res.groups">
        <field name="name">AI Assistant / Manager</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('odoo_ai_assistant.group_ai_assistant_user'))]"/>
    </record>

</odoo>
